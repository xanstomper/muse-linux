{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse",
  "version": "0.1.0",
  "identifier": "com.xanstomper.muselinux",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Muse",
        "width": 1200,
        "height": 860,
        "minWidth": 480,
        "minHeight": 600,
