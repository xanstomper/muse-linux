{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-muse",
  "windows": [
    "*"
  ],
  "context": "remote",
  "remote": {
    "urls": [
      "https://muse.ai/*",
      "https://*.muse.ai/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "shell:allow-open",
    "allow-daemon-pair-start",
    "allow-daemon-pair-poll",
    "allow-daemon-connect",
    "allow-daemon-disconnect",
    "allow-daemon-probe",
    "allow-daemon-status",
    "allow-daemon-get-connection",
    "allow-set-yolo",
    "allow-audit-tail",
    "allow-set-notify-enabled"
  ]
}
